# backend/.env.example  (NO subir a git; copia como .env.local o .env en dev)
# -------------------------
# SECRET & DEBUG
SECRET_KEY=django-insecure-REEMPLAZAME_CON_VALOR_SEGUR0
DEBUG=1                      # 1 para dev; 0 en producción

# Hosts
ALLOWED_HOSTS=127.0.0.1,localhost
# Si usas production añade tu dominio: example.com,www.example.com

# Database engine: 'sqlite' o 'postgres'
DATABASE_ENGINE=sqlite      # valores posibles: sqlite | postgres

# If using Postgres (docker-compose)
POSTGRES_DB=domipyme
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# FRONTEND base (usado por reset password / links en emails)
# Nota: en settings.py vamos a leer FRONTEND_URL (coherencia con el código)
FRONTEND_URL=http://localhost:5173

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# EMAIL (para enviar correos reales)
# Opciones para EMAIL_BACKEND:
# - console -> django.core.mail.backends.console.EmailBackend
# - locmem  -> django.core.mail.backends.locmem.EmailBackend (tests)
# - smtp    -> django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=no-reply@domipyme.com

# Optional: Sentry DSN for error tracing (opcional)
SENTRY_DSN=

# Optional: toggle email fail silently in dev (0 or 1)
EMAIL_FAIL_SILENTLY=0
