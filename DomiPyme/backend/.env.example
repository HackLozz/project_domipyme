# backend/.env.example  (NO subir a git; copia como .env.local o .env en dev)
# -------------------------
# SECRET & DEBUG
SECRET_KEY=django-insecure-REEMPLAZAME_CON_VALOR_SEGUR0
DEBUG=1                      # 1 para dev; 0 en producción

# Hosts (separar por espacios o comas)
ALLOWED_HOSTS=127.0.0.1 localhost
# En producción añade tu dominio: example.com www.example.com

# Database engine: 'sqlite' o 'postgres'
DATABASE_ENGINE=sqlite      # valores posibles: sqlite | postgres

# Si usas Postgres (docker-compose o servidor externo)
POSTGRES_DB=domipyme
POSTGRES_USER=domipyme
POSTGRES_PASSWORD=domipyme_secure_password
POSTGRES_HOST=db            # 'db' para docker-compose; 'localhost' para local
POSTGRES_PORT=5432

# FRONTEND base (usado por reset password / links en emails)
# Cambio: ahora usamos FRONTEND_BASE_URL en código
FRONTEND_BASE_URL=http://localhost:5173

# CORS / CSRF (separar múltiples orígenes por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# EMAIL (para enviar correos reales)
# Opciones para EMAIL_BACKEND:
# - console -> django.core.mail.backends.console.EmailBackend (dev, imprime en consola)
# - locmem  -> django.core.mail.backends.locmem.EmailBackend (tests, guarda en memoria)
# - smtp    -> django.core.mail.backends.smtp.EmailBackend (producción, envío real)
EMAIL_BACKEND=console       # Cambia a 'smtp' para envío real
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=no-reply@domipyme.com

# Alternativa Gmail (recomendado usar App Password):
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587            # o 465 con EMAIL_USE_SSL=1 y EMAIL_USE_TLS=0
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=tu_app_password_de_gmail
# DEFAULT_FROM_EMAIL=tu_correo@gmail.com

# Seguridad (opcional en dev, obligatorio en producción)
# SESSION_COOKIE_SECURE=1     # Solo con HTTPS
# CSRF_COOKIE_SECURE=1        # Solo con HTTPS
# SECURE_SSL_REDIRECT=1       # Redirigir HTTP a HTTPS
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# SECURE_HSTS_PRELOAD=1
# EMAIL_HOST_PASSWORD=APP_PASSWORD_GENERADA

# Optional: Sentry DSN for error tracing (opcional)
SENTRY_DSN=

# Optional: toggle email fail silently in dev (0 or 1)
SHOW_RESET_URL_IN_RESPONSE=1
