# backend/.env  (NO subir a git)
SECRET_KEY=django-insecure-REEMPLAZAME_CON_VALOR_SEGUR0
DEBUG=1                # 1 para dev; en prod usar 0
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_ENGINE=sqlite  # 'postgres' si usas docker-compose postgres
# Si usas postgres -> añadir:
# POSTGRES_DB=domipyme
# POSTGRES_USER=domipyme
# POSTGRES_PASSWORD=domipyme
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# FRONTEND base (usado por reset password)
FRONTEND_BASE_URL=http://localhost:5173

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# EMAIL (para enviar correos reales)
# Para dev puedes mantener console:
# EMAIL_BACKEND=console
# Para SendGrid / Mailgun:
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SENDGRID_API_KEY
DEFAULT_FROM_EMAIL=no-reply@domipyme.com
